---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;
---

<BaseLayout title={config.title} description={config.description}>
  <script is:inline>
    (() => {
      try {
        const supported = ["zh", "en", "fr", "ja", "ko", "de", "es"];
        const pref = localStorage.getItem("preferred_lang");
        if (pref && supported.includes(pref)) {
          window.location.replace(`/${pref}/intro`);
          return;
        }
        const browserLang = (navigator.language || "").toLowerCase();
        for (const l of supported) {
          if (browserLang.startsWith(l)) {
            window.location.replace(`/${l}/intro`);
            return;
          }
        }
        window.location.replace("/zh/intro");
      } catch {
        window.location.replace("/zh/intro");
      }
    })();
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/zh/intro" />
  </noscript>

  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-4xl w-full px-6 py-16">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        EQT Technical Documentation
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        Ultra-fast peer-to-peer LAN streaming & LAN-TLS architecture. / 局域网高速传输、Chat 模式与 LAN-TLS 架构全景指南。
      </p>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a
          href={withBase("/zh/intro", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">🇨🇳 简体中文文档</div>
          <div class="mt-1 text-xs text-muted-foreground">用户指南、故障排查、CLI 手册与安全白皮书。</div>
        </a>
        <a
          href={withBase("/en/intro", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">🌐 English Docs</div>
          <div class="mt-1 text-xs text-muted-foreground">User guides, troubleshooting, CLI manual, and security whitepaper.</div>
        </a>
        <a
          href={withBase("/fr/intro", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">🇫🇷 Français</div>
          <div class="mt-1 text-xs text-muted-foreground">Guides d'utilisation, dépannage, manuel CLI et livre blanc.</div>
        </a>
        <a
          href={withBase("/ja/intro", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">🇯🇵 日本語</div>
          <div class="mt-1 text-xs text-muted-foreground">ユーザーガイド、トラブルシューティング、CLI、セキュリティ白書。</div>
        </a>
        <a
          href={withBase("/ko/intro", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">🇰🇷 한국어</div>
          <div class="mt-1 text-xs text-muted-foreground">사용자 가이드, 문제 해결, CLI 매뉴얼 및 보안 백서.</div>
        </a>
        <a
          href={withBase("/de/intro", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">🇩🇪 Deutsch</div>
          <div class="mt-1 text-xs text-muted-foreground">Benutzerhandbuch, Fehlerbehebung, CLI und Whitepaper.</div>
        </a>
        <a
          href={withBase("/es/intro", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">🇪🇸 Español</div>
          <div class="mt-1 text-xs text-muted-foreground">Guías de usuario, resolución de problemas, CLI y libro blanco.</div>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
