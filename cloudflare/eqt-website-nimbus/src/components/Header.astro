---
import type { SidebarSection } from "@cloudflare/nimbus-docs/types";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { config } from "virtual:nimbus/config";
import { getSidebarSections, stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  sections?: SidebarSection[];
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const { collection, showSidebar = true, sections: sectionsProp } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const isEn = currentSlug.startsWith("en/") || currentSlug === "en" || currentSlug.startsWith("/en/") || currentSlug === "/en";
const isFr = currentSlug.startsWith("fr/") || currentSlug === "fr" || currentSlug.startsWith("/fr/") || currentSlug === "/fr";
const currentLang: "zh" | "en" | "fr" = isEn ? "en" : isFr ? "fr" : "zh";
const siteTitle = isEn ? "EQT Documentation" : isFr ? "Documentation EQT" : config.title;
const homeHref = withBase(isEn ? "/en/intro" : isFr ? "/fr/intro" : "/zh/intro", import.meta.env.BASE_URL);

const pathname = Astro.url.pathname;
let zhHref = withBase("/zh/intro", import.meta.env.BASE_URL);
let enHref = withBase("/en/intro", import.meta.env.BASE_URL);
let frHref = withBase("/fr/intro", import.meta.env.BASE_URL);

if (pathname.includes("/en/")) {
  enHref = pathname;
  zhHref = pathname.replace("/en/", "/zh/");
  frHref = pathname.replace("/en/", "/fr/");
} else if (pathname.endsWith("/en")) {
  enHref = pathname;
  zhHref = pathname.replace(/\/en$/, "/zh/intro");
  frHref = pathname.replace(/\/en$/, "/fr/intro");
} else if (pathname.includes("/fr/")) {
  frHref = pathname;
  zhHref = pathname.replace("/fr/", "/zh/");
  enHref = pathname.replace("/fr/", "/en/");
} else if (pathname.endsWith("/fr")) {
  frHref = pathname;
  zhHref = pathname.replace(/\/fr$/, "/zh/intro");
  enHref = pathname.replace(/\/fr$/, "/en/intro");
} else if (pathname.includes("/zh/")) {
  zhHref = pathname;
  enHref = pathname.replace("/zh/", "/en/");
  frHref = pathname.replace("/zh/", "/fr/");
} else if (pathname.endsWith("/zh")) {
  zhHref = pathname;
  enHref = pathname.replace(/\/zh$/, "/en/intro");
  frHref = pathname.replace(/\/zh$/, "/fr/intro");
}

const sections =
  sectionsProp ?? (await getSidebarSections(currentSlug, { collection }));
const showSections = sections.length >= 2;
const resolveSectionHref = (href: string): string =>
  withBase(href, import.meta.env.BASE_URL);
---

<header class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between gap-3 h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3 min-w-0">
      <slot name="brand">
        <a href={homeHref} class="group shrink-0">
          <span class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
            {siteTitle}
          </span>
        </a>
      </slot>

      {showSections && (
        <nav aria-label="Sections" class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6 min-w-0 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {sections.map((section) => (
            <a
              href={resolveSectionHref(section.href)}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
                section.isActive
                  ? "text-foreground bg-accent"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <slot name="actions" />
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <LanguageSwitcher currentLang={currentLang} zhHref={zhHref} enHref={enHref} frHref={frHref} />
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>
