---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";

export type { SupportedLang } from "@/i18n";
import { type SupportedLang, LANGUAGES_META } from "@/i18n";

interface Props {
  currentLang: SupportedLang;
  zhHref: string;
  enHref: string;
  frHref: string;
  jaHref: string;
  koHref: string;
  deHref: string;
  esHref: string;
  class?: string;
}

const { currentLang, zhHref, enHref, frHref, jaHref, koHref, deHref, esHref, class: className } = Astro.props;

const hrefMap: Record<SupportedLang, string> = {
  zh: zhHref,
  en: enHref,
  fr: frHref,
  ja: jaHref,
  ko: koHref,
  de: deHref,
  es: esHref,
};

const languages = LANGUAGES_META.map((item) => ({
  code: item.code,
  label: item.label,
  href: hrefMap[item.code] || zhHref,
}));

const currentLabel = languages.find((l) => l.code === currentLang)?.label || "Language";
---

<div class={cn("relative inline-block text-left", className)} data-lang-switcher>
  <button
    type="button"
    class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent rounded-md border border-border transition-colors cursor-pointer"
    aria-expanded="false"
    aria-haspopup="true"
    data-lang-btn
    aria-label="Select language"
  >
    <Icon name="ph:globe" class="w-4 h-4 shrink-0" />
    <span>{currentLabel}</span>
    <Icon name="ph:caret-down" class="w-3 h-3 text-muted-foreground shrink-0" />
  </button>

  <div
    class="hidden absolute right-0 mt-1 w-36 rounded-md shadow-lg bg-card border border-border ring-1 ring-black/5 z-50 py-1 focus:outline-none"
    role="menu"
    aria-orientation="vertical"
    data-lang-menu
  >
    {languages.map((l) => (
      <a
        href={l.href}
        class:list={[
          "flex items-center justify-between px-3 py-1.5 text-xs no-underline transition-colors",
          currentLang === l.code
            ? "font-semibold text-foreground bg-accent"
            : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
        ]}
        role="menuitem"
        data-lang={l.code}
      >
        <span>{l.label}</span>
        {currentLang === l.code && <Icon name="ph:check" class="w-3.5 h-3.5 text-primary" />}
      </a>
    ))}
  </div>
</div>

<script>
  function setupLangSwitchers() {
    document.querySelectorAll("[data-lang-switcher]").forEach((switcher) => {
      const btn = switcher.querySelector<HTMLButtonElement>("[data-lang-btn]");
      const menu = switcher.querySelector<HTMLDivElement>("[data-lang-menu]");
      if (!btn || !menu) return;

      const toggle = (show?: boolean) => {
        const isOpen = show ?? menu.classList.contains("hidden");
        if (isOpen) {
          menu.classList.remove("hidden");
          btn.setAttribute("aria-expanded", "true");
        } else {
          menu.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
        }
      };

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggle();
      });

      document.addEventListener("click", (e) => {
        if (!switcher.contains(e.target as Node)) {
          toggle(false);
        }
      });

      menu.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((link) => {
        link.addEventListener("click", () => {
          const lang = link.getAttribute("data-lang");
          if (lang) {
            localStorage.setItem("preferred_lang", lang);
          }
        });
      });
    });
  }

  setupLangSwitchers();
  document.addEventListener("astro:after-swap", setupLangSwitchers);
</script>
