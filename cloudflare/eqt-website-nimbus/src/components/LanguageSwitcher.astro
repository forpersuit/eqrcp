---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";

interface Props {
  currentLang: "zh" | "en" | "fr";
  zhHref: string;
  enHref: string;
  frHref: string;
  class?: string;
}

const { currentLang, zhHref, enHref, frHref, class: className } = Astro.props;

const langLabelMap: Record<"zh" | "en" | "fr", string> = {
  zh: "简体中文",
  en: "English",
  fr: "Français",
};
---

<div class={cn("relative inline-block text-left", className)} data-lang-switcher>
  <button
    type="button"
    class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent rounded-md border border-border transition-colors cursor-pointer"
    aria-expanded="false"
    aria-haspopup="true"
    data-lang-btn
    aria-label="Select language"
  >
    <Icon name="ph:globe" class="w-4 h-4 shrink-0" />
    <span>{langLabelMap[currentLang] || "Language"}</span>
    <Icon name="ph:caret-down" class="w-3 h-3 text-muted-foreground shrink-0" />
  </button>

  <div
    class="hidden absolute right-0 mt-1 w-32 rounded-md shadow-lg bg-card border border-border ring-1 ring-black/5 z-50 py-1 focus:outline-none"
    role="menu"
    aria-orientation="vertical"
    data-lang-menu
  >
    <a
      href={zhHref}
      class:list={[
        "flex items-center justify-between px-3 py-1.5 text-xs no-underline transition-colors",
        currentLang === "zh"
          ? "font-semibold text-foreground bg-accent"
          : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
      ]}
      role="menuitem"
      data-lang="zh"
    >
      <span>简体中文</span>
      {currentLang === "zh" && <Icon name="ph:check" class="w-3.5 h-3.5 text-primary" />}
    </a>
    <a
      href={enHref}
      class:list={[
        "flex items-center justify-between px-3 py-1.5 text-xs no-underline transition-colors",
        currentLang === "en"
          ? "font-semibold text-foreground bg-accent"
          : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
      ]}
      role="menuitem"
      data-lang="en"
    >
      <span>English</span>
      {currentLang === "en" && <Icon name="ph:check" class="w-3.5 h-3.5 text-primary" />}
    </a>
    <a
      href={frHref}
      class:list={[
        "flex items-center justify-between px-3 py-1.5 text-xs no-underline transition-colors",
        currentLang === "fr"
          ? "font-semibold text-foreground bg-accent"
          : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
      ]}
      role="menuitem"
      data-lang="fr"
    >
      <span>Français</span>
      {currentLang === "fr" && <Icon name="ph:check" class="w-3.5 h-3.5 text-primary" />}
    </a>
  </div>
</div>

<script>
  function setupLangSwitchers() {
    document.querySelectorAll("[data-lang-switcher]").forEach((switcher) => {
      const btn = switcher.querySelector<HTMLButtonElement>("[data-lang-btn]");
      const menu = switcher.querySelector<HTMLDivElement>("[data-lang-menu]");
      if (!btn || !menu) return;

      const toggle = (show?: boolean) => {
        const isOpen = show ?? menu.classList.contains("hidden");
        if (isOpen) {
          menu.classList.remove("hidden");
          btn.setAttribute("aria-expanded", "true");
        } else {
          menu.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
        }
      };

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggle();
      });

      document.addEventListener("click", (e) => {
        if (!switcher.contains(e.target as Node)) {
          toggle(false);
        }
      });

      menu.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((link) => {
        link.addEventListener("click", () => {
          const lang = link.getAttribute("data-lang");
          if (lang) {
            localStorage.setItem("preferred_lang", lang);
          }
        });
      });
    });
  }

  setupLangSwitchers();
  document.addEventListener("astro:after-swap", setupLangSwitchers);
</script>
