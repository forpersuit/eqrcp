{
  "name": "eqt-drm-api",
  "version": "1.5.0",
  "description": "Serverless Licensing & DRM Backend for EQT on Cloudflare",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create eqt-drm-db",
    "db:init:local": "wrangler d1 execute eqt-drm-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute eqt-drm-db --remote --file=./schema.sql",
    "test:e2e": "node tests/e2e-drm-test.js",
    "test:admin": "node tests/e2e-admin-test.js",
    "test:admin:live": "npx esbuild src/routes/admin.ts --bundle --alias:cloudflare:sockets=./tests/mocks/cloudflare-sockets-stub.js --outfile=tests/compiled/admin.js --platform=node --format=cjs && node tests/admin-live-devices-offline.js",
    "test:device-reg": "node tests/device-registration-test.js",
    "test:device-reg:offline": "node tests/device-reg-offline-test.js",
    "test:upgrade:offline": "npx esbuild src/routes/drm.ts src/routes/paddle.ts src/routes/portal.ts --bundle --alias:cloudflare:sockets=./tests/mocks/cloudflare-sockets-stub.js --outdir=tests/compiled --platform=node --format=cjs && node tests/verify-pending-lifetime-upgrade-offline.js",
    "test:upgrade:e2e": "node tests/verify-pending-upgrade-e2e.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.113.0"
  }
}
